---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentChannels from '../components/ContentChannels.astro';
import AiNoteCards from '../components/AiNoteCards.astro';
import { getAiNotes } from '../../scripts/ai-notes.mjs';
const count = getAiNotes().length;
---
<BaseLayout title="HTML 专题 · Charlie Liu" description="完整HTML方案、可视化研究报告与独立专题页面。">
  <header class="channel-header">
    <p class="eyebrow">AI NOTES · 完整方案与独立页面</p>
    <h1>HTML 专题</h1>
    <p>把完整方案和研究成果单独展开。保留每份HTML的目录、图表与交互，不再与博客文章列表混排。</p>
  </header>
  <ContentChannels />
  <div class="topics-heading"><h2>全部专题</h2><span>{count} 份 HTML</span></div>
  <AiNoteCards />
  <p class="channel-note">选择“新标签页打开”可保留当前目录；也可以在当前页阅读。每份专题底部都有“HTML专题、博客文章、收藏原文、首页”的固定返回入口。专题中的原始来源仍保留原站链接。</p>
  <div class="channel-back"><a href="/">← 返回首页</a><a href="/posts/">阅读博客文章 →</a><a href="/collection/">查看原文收藏 →</a></div>
</BaseLayout>
