---
import BaseLayout from "../layouts/BaseLayout.astro";

const rawPosts = import.meta.glob("../content/posts/*.md", { eager: true });
const posts = (Object.values(rawPosts) as any[])
  .filter((post) => !post.frontmatter.draft)
  .sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime());
---

<BaseLayout>
  <header class="channel-header animate-on-scroll">
    <p class="eyebrow">AI INTERPRETATION · 人提出问题，AI 展开研究</p>
    <h1>AI 生成的解读</h1>
    <p>围绕一个真实任务，让 AI 搜集、比较、推演，再由我筛选和校正。成果可以是一篇文章，也可以是演示文稿、图像或研究备忘录。</p>
  </header>

  <div class="format-rail" aria-label="内容形式">
    <span class="active">文章</span><span>PPT</span><span>图片</span><span>研究备忘录</span>
  </div>

  <section class="research-list">
    {posts.map((post, index) => (
      <a class="research-entry animate-on-scroll" href={`/posts/${post.frontmatter.slug}`}>
        <span class="entry-number">{String(index + 1).padStart(2, "0")}</span>
        <div>
          <div class="entry-meta"><span>ARTICLE</span><time>{new Date(post.frontmatter.date).toLocaleDateString("zh-CN")}</time></div>
          <h2>{post.frontmatter.title}</h2>
          <p>{post.frontmatter.description}</p>
        </div>
        <span class="entry-arrow">↗</span>
      </a>
    ))}
  </section>
</BaseLayout>
