---
import { SITE } from '../config';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentChannels from '../components/ContentChannels.astro';
import AiNoteCards from '../components/AiNoteCards.astro';
const rawPosts = import.meta.glob('../content/posts/*.md', { eager: true });
const publishedPosts = (Object.values(rawPosts) as any[])
  .filter(p => !p.frontmatter.draft)
  .sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime());
---
<BaseLayout>
  <section class="home-hero animate-on-scroll">
    <div class="hero-copy">
      <p class="eyebrow">CHARLIE'S FIELD NOTES · 2026</p>
      <h1 class="hero-title text-balance">把复杂的问题，<br /><em>想得更清楚一点。</em></h1>
      <p class="hero-description">{SITE.description}</p>
      <div class="hero-links"><a href="/about">认识 Charlie <span>↗</span></a><a href="/rss.xml">订阅 RSS <span>↗</span></a></div>
    </div>
    <aside class="hero-note" aria-label="本站关注方向"><span class="note-index">01—03</span><p>AI 协作</p><p>系统思考</p><p>研究方法</p><small>持续观察，长期写作。</small></aside>
  </section>
  <ContentChannels />
  <section aria-labelledby="featured-topics"><div class="topics-heading"><h2 id="featured-topics">HTML 专题 · 完整方案</h2><a href="/ai-notes/">查看全部专题 →</a></div><AiNoteCards limit={3} /></section>
  <div class="section-rule"><span>Selected writing</span></div>
  <div class="flex items-center justify-between mb-8"><h2 class="text-xs font-semibold tracking-widest uppercase" style="color:var(--color-text-faint);letter-spacing:.12em">最新文章</h2><span class="text-xs" style="color:var(--color-text-faint)">{publishedPosts.length} 篇</span></div>
  <div class="space-y-3">
    {publishedPosts.length === 0 ? <div class="py-20 text-center animate-on-scroll"><p class="text-lg mb-2" style="color:var(--color-text-muted)">还在酝酿第一篇故事...</p><p class="text-sm" style="color:var(--color-text-faint)">写好之后，会第一时间放在这里。</p></div> : publishedPosts.map((post, index) => (
      <a href={`/posts/${post.frontmatter.slug}`} class="article-card animate-on-scroll" style={`animation-delay:${index * .06}s`}>
        <div class="flex flex-col gap-3">
          <div class="flex items-center gap-3 flex-wrap"><time datetime={new Date(post.frontmatter.date).toISOString()} class="date-badge">{new Date(post.frontmatter.date).toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}</time><span style="color:var(--color-text-faint);font-size:.75rem">·</span>{(post.frontmatter.tags as string[])?.slice(0, 3).map(tag => <span class="tag">{tag}</span>)}</div>
          <h3 class="text-xl font-bold tracking-tight" style="color:var(--color-text);line-height:1.4;letter-spacing:-.015em">{post.frontmatter.title}</h3>
          <p class="text-sm leading-relaxed line-clamp-2" style="color:var(--color-text-muted)">{post.frontmatter.description}</p>
          <div class="flex items-center gap-1 mt-1"><span class="text-xs font-medium" style="color:var(--color-accent)">阅读全文 →</span></div>
        </div>
      </a>
    ))}
  </div>
  {publishedPosts.length > 0 && <div class="mt-10 text-center animate-on-scroll"><a href="/posts/" class="btn">查看全部文章 →</a></div>}
</BaseLayout>
